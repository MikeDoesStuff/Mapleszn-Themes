{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Mist Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#E2ECFC",
    "editor.foreground": "#162234",
    "foreground": "#162234",
    "focusBorder": "#347AA8",
    "button.background": "#347AA8",
