    "button.hoverBackground": "#246B98",
    "textLink.foreground": "#074C73",
    "textLink.activeForeground": "#074C73",
    "editorWidget.background": "#EAF2FF",
    "editorWidget.border": "#C0CDE1",
    "dropdown.background": "#EAF2FF",
    "dropdown.border": "#C0CDE1",
    "dropdown.foreground": "#162234",
    "menu.background": "#F0F6FF",
    "menu.foreground": "#162234",
