{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Frost Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#E1ECFC",
    "editor.foreground": "#152234",
    "foreground": "#152234",
    "focusBorder": "#BF5143",
