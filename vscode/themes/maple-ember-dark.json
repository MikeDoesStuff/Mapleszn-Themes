{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Ember Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#30333B",
    "editor.foreground": "#E4DED5",
    "foreground": "#E4DED5",
    "focusBorder": "#D8A778",
    "button.background": "#D8A778",
