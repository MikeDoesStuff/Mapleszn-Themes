    "button.hoverBackground": "#E5B78D",
    "textLink.foreground": "#D8A778",
    "textLink.activeForeground": "#F2C59D",
    "editorWidget.background": "#3D4049",
    "editorWidget.border": "#50515A",
    "dropdown.background": "#3D4049",
    "dropdown.border": "#50515A",
    "dropdown.foreground": "#E4DED5",
    "menu.background": "#454750",
