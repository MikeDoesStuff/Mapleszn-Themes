{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Sugar Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#2A3339",
    "editor.foreground": "#E4EBEF",
