{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Mist Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#343B46",
    "editor.foreground": "#E5EAF0",
    "foreground": "#E5EAF0",
    "focusBorder": "#A9C7DE",
    "button.background": "#A9C7DE",
