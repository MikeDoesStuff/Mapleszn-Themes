{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Oat Dark",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#393936",
    "editor.foreground": "#EAE5DB",
    "foreground": "#EAE5DB",
    "focusBorder": "#DBBC91",
    "button.background": "#DBBC91",
