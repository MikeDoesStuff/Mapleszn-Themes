    "dropdown.foreground": "#19222E",
    "menu.background": "#F2F6FC",
    "menu.foreground": "#19222E",
    "menu.selectionBackground": "#FACEBF",
    "menu.selectionForeground": "#72321C",
    "menu.border": "#C3CDDA",
    "quickInput.background": "#F2F6FC",
