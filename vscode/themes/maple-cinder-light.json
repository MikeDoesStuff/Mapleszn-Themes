{
  "$schema": "vscode://schemas/color-theme",
  "name": "Maple Cinder Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#E4ECF6",
    "editor.foreground": "#19222E",
    "foreground": "#19222E",
    "focusBorder": "#AC5F46",
    "button.background": "#AC5F46",
